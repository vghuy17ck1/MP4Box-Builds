#!/usr/bin/env bash
set -euo pipefail

prefix="${TARGET_PREFIX:?TARGET_PREFIX must be set}"
log_file="${PKG_CONFIG_STATIC_LOG:-$prefix/pkg-config-requests.log}"
mkdir -p "$(dirname "$log_file")"
export PKG_CONFIG_ALL_STATIC=1
export PKG_CONFIG_LIBDIR="$prefix/lib/pkgconfig:$prefix/share/pkgconfig"
export PKG_CONFIG_PATH="$PKG_CONFIG_LIBDIR"
export PKG_CONFIG_SYSROOT_DIR="${PKG_CONFIG_SYSROOT_DIR:-/}"

output="$(pkg-config "$@")"
case "$output" in
    *"/usr/lib"*|*"/usr/local/lib"*|*"/opt/homebrew"*|*"/Library/"*)
        printf 'host path leaked through pkg-config: %s\n' "$output" >&2
        exit 1
        ;;
esac
printf '%s\t%s\n' "$(date -u +%s)" "$*" >> "$log_file"
printf '%s\n' "$output"
